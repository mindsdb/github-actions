{
  "name": "CLA check: allow pull_request_target and issue_comment",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["~ALL"],
      "exclude": []
    },
    "workflow_path": {
      "include": [".github/workflows/cla.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target", "issue_comment"]
      }
    }
  ]
}
